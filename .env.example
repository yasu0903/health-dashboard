# Google Cloud Console で作成した OAuth 2.0 クライアント (種類: ウェブ アプリケーション)
# 未設定のままだとデモデータで起動します
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ブラウザからアクセスするURL。OAuthクライアントの「承認済みのリダイレクト URI」に
# ${APP_BASE_URL}/auth/callback を登録してください (既定: http://localhost:3000/auth/callback)
APP_BASE_URL=http://localhost:3000
PORT=3000

# 日付の区切りに使うタイムゾーン
TZ=Asia/Tokyo

# true にすると認証情報があってもデモデータを表示します
# DEMO_MODE=false

# Google Health API の取得結果をキャッシュする秒数
# CACHE_TTL_SECONDS=300
